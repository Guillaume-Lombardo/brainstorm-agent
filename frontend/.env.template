# Frontend environment (server-side only: no NEXT_PUBLIC_ variable is used).
# Copy to .env.local for `pnpm dev`; containers receive the same variables.

# --- Auth.js ---
# Session cookie signing secret, e.g. `openssl rand -base64 32`. Required.
AUTH_SECRET=
# Public URL of the frontend.
AUTH_URL=http://localhost:3000

# Optional OIDC provider. "Sign in with <AUTH_OIDC_NAME>" is shown only when
# the issuer, client id and client secret are all set.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=SSO

# --- Backend ---
# mock: in-memory demo backend (default outside production).
# http: real backend; required explicitly in production.
BACKEND_MODE=mock
BACKEND_URL=http://localhost:8000
# Shared HS256 secret: same value as the backend JWT_SECRET_KEY.
BACKEND_JWT_SECRET=
# Must match the backend JWT_ISSUER / JWT_AUDIENCE when those are set.
BACKEND_JWT_ISSUER=
BACKEND_JWT_AUDIENCE=
# Lifetime of the token minted per backend call.
BACKEND_JWT_TTL_SECONDS=60
# Service API key for pre-authentication calls (password check, OIDC linking).
BACKEND_SERVICE_API_KEY=

# --- Mock backend (BACKEND_MODE=mock) ---
# Delay between streamed events, in milliseconds.
MOCK_STREAM_DELAY_MS=40
# Password of the demo accounts demo@example.com and empty@example.com
# (defaults to "brainstorm-demo").
MOCK_USER_PASSWORD=
