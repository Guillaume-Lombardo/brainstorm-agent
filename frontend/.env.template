# Frontend environment (server-side only: no NEXT_PUBLIC_ variable is used).
# Copy to .env.local for `pnpm dev`; containers receive the same variables.
# For `pnpm dev:backend` (local backend, fake LLM), copy the secrets, issuer and audience
# from `scripts/e2e-env.mjs`.

# --- Auth.js ---
# Session cookie signing secret, e.g. `openssl rand -hex 32`. Required.
AUTH_SECRET=
# Public URL of the frontend. Mutating proxy requests must come from this origin.
AUTH_URL=http://localhost:3000

# Optional OIDC provider. "Sign in with <AUTH_OIDC_NAME>" is shown only when
# the issuer, client id and client secret are all set. Only profiles with
# `email_verified: true` may sign in.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=SSO

# --- Backend (internal network only; never exposed to the browser) ---
BACKEND_URL=http://127.0.0.1:8100
# Shared HS256 secret, same value as the backend JWT_SECRET_KEY (at least 32 characters).
BACKEND_JWT_SECRET=
# Must match the backend JWT_ISSUER / JWT_AUDIENCE.
BACKEND_JWT_ISSUER=brainstorm-frontend
BACKEND_JWT_AUDIENCE=brainstorm-backend
# Lifetime of the token minted per backend call.
BACKEND_JWT_TTL_SECONDS=60
# `X-Auth-Bridge` secret of the login bridge, same value as the backend
# AUTH_BRIDGE_SECRET (at least 32 characters, different from BACKEND_JWT_SECRET).
AUTH_BRIDGE_SECRET=

# API types: run `pnpm generate:api` after a backend contract change.
