APP_ENV=dev
HOST=127.0.0.1
PORT=8000
ENABLE_AUTH=false
AUTH_API_KEYS=
AUTH_MODE=none
AUTH_API_KEY_HASHES=
AUTH_API_KEY_PEPPER=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
JWT_ISSUER=
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE=

DATABASE_URL=postgresql+psycopg://brainstorm:brainstorm@postgres:5432/brainstorm  # pragma: allowlist secret
AUTO_CREATE_SCHEMA=true
RUN_DB_MIGRATIONS_ON_STARTUP=false
REDIS_URL=redis://redis:6379/0
REDIS_LOCK_TIMEOUT_SECONDS=180
REDIS_LOCK_BLOCKING_TIMEOUT_SECONDS=5
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_NAMESPACE=brainstorm-agent

LLM_MODE=openai
LLM_OUTPUT_MODE=json_schema
LLM_CHALLENGE_PASS=off
LLM_CONTEXT_TURNS=8
LLM_MAX_TOKENS=4096
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=change-me  # pragma: allowlist secret
MODEL_NAME=claude-opus-5-5
OPENAI_TIMEOUT_SECONDS=30
OPENAI_FACADE_MODEL_NAME=brainstorm-agent
REQUIRE_HUMAN_VALIDATION_FOR_TRANSITIONS=false
PROMPT_VERSION=v2
PROMPT_BASE_PATH=

# Authentication bridge (server-only Next.js calls; disabled when empty)
# Use at least 32 random bytes; never reuse the JWT signing secret.
AUTH_BRIDGE_SECRET=
OIDC_ISSUER=
# Budget per normalized identity and flow, shared across replicas when Redis is available
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# JSON object mapping normalized API-key hashes (sha256$... or v1$...) to users.id
AUTH_API_KEY_OWNERS={}
